#include "GPIO_Driver.h"
#include "TIM_Driver.h"



int main()
{


    /**********************************************************
     * GPIO Configuration
     *
     * STM32F407 Discovery Board
     *
     * PD12 -> Green LED
     *
     **********************************************************/

    GPIO led(
        GPIO_Port::PORTD,
        12
    );


    led.clockEnable();


    led.setMode(
        GPIO_Mode::OUTPUT
    );


    led.setOutputType(
        GPIO_OutputType::PUSH_PULL
    );


    led.setSpeed(
        GPIO_Speed::HIGH
    );


    led.setPull(
        GPIO_Pull::NO_PULL
    );



    /**********************************************************
     * TIM2 Configuration
     *
     * Timer clock = 84MHz
     *
     * Prescaler:
     *
     * 8400 - 1
     *
     * Timer frequency:
     *
     * 84MHz / 8400 = 10KHz
     *
     * ARR:
     *
     * 10000 - 1
     *
     * Overflow:
     *
     * 10000 / 10000Hz = 1 second
     *
     **********************************************************/

    TIM timer(
        TIM_Instance::TIM2
    );


    timer.init(
        TIM_CounterMode::UP
    );


    timer.setPrescaler(
        8400 - 1
    );


    timer.setAutoReload(
        10000 - 1
    );


    timer.start();



    while(1)
    {


        /*
         * Wait for TIM2 update event
         */

        if(timer.isUpdateEvent())
        {

            /*
             * Clear update flag
             */

            timer.clearUpdateEvent();



            /*
             * Toggle LED
             */

            led.toggle();

        }


    }


}
