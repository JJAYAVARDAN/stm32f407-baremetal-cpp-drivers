#include<cstdio>
#include"Gpio_Driver.h"
#include"USART_Driver.h"
#include"SysTick_Driver.h"
#include"ADC_Driver.h"

int main()
{
    /**************************************************************
     * Configure PA0 as Analog Input
     **************************************************************/
	GPIO adcPin(GPIO_Port::PORTA,0);
    adcPin.clockEnable();
    adcPin.setMode(GPIO_Mode::ANALOG);
    adcPin.setPull(GPIO_Pull::NO_PULL);
    /**************************************************************
     * Configure USART2
     *
     * PA2 -> TX
     * PA3 -> RX
     **************************************************************/
    GPIO tx(GPIO_Port::PORTA, 2);
    GPIO rx(GPIO_Port::PORTA, 3);

    tx.clockEnable();
    rx.clockEnable();

    tx.setMode(GPIO_Mode::ALTERNATE_FUNCTION);
    rx.setMode(GPIO_Mode::ALTERNATE_FUNCTION);

    tx.setAlternateFunction(7);
    rx.setAlternateFunction(7);

    tx.setOutputType(GPIO_OutputType::PUSH_PULL);
    tx.setSpeed(GPIO_Speed::VERY_HIGH);
    tx.setPull(GPIO_Pull::PULL_UP);

    rx.setPull(GPIO_Pull::PULL_UP);

    USART usart(USART_Instance::USART2);

    usart.init(
        115200,
        USART_Mode::TX_RX,
        USART_WordLength::BITS_8,
        USART_StopBits::STOP_1,
        USART_Parity::NONE);

    /**************************************************************
     * Configure ADC1
     **************************************************************/

    ADC adc(ADC_Instance::ADC1);

    adc.init(
        ADC_Resolution::BITS_12,
        ADC_Alignment::RIGHT,
        ADC_Mode:);

    adc.selectChannel(ADC_Channel::CH0);

    adc.setSampleTime(
        ADC_Channel::CH0,
        ADC_SampleTime::CYCLES_84);

    /**************************************************************
     * Configure SysTick
     **************************************************************/

    SysTick tick;

    tick.init(1000);

    char buffer[32];

    /**************************************************************
     * Main Loop
     **************************************************************/

    while (1)
    {
        adc.startConversion();

        uint16_t value = adc.read();

        std::snprintf(buffer,
            sizeof(buffer),
            "ADC = %u\r\n",
            value);

        usart.txString(buffer);

        tick.delayMs(500);
    }
}

