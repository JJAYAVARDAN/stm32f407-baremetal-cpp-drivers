/*********************************************************************
 *                      Includes
 *********************************************************************/

#include "GPIO_Driver.h"
#include "TIM_Driver.h"
#include "ADC_Driver.h"
#include "USART_Driver.h"
#include "SPI_Driver.h"
#include "I2C_Driver.h"
#include "EXTI_Driver.h"



int main()
{


    /**************************************************************
     * GPIO Test
     *
     * STM32F407 Discovery Board LED
     *
     * PD12 Green LED
     **************************************************************/

    GPIO led(
        GPIO_Port::PORTD,
        12
    );


    led.setMode(
        GPIO_Mode::OUTPUT
    );


    led.setOutputType(
        GPIO_OutputType::PUSH_PULL
    );


    led.setSpeed(
        GPIO_Speed::HIGH
    );


    led.setPull(
        GPIO_Pull::NO_PULL
    );



    /**************************************************************
     * TIM2 Test
     *
     * Timer clock:
     *
     * APB1 Timer Clock = 84MHz
     *
     * Prescaler:
     * 8400 - 1
     *
     * Timer frequency:
     *
     * 84MHz / 8400 = 10KHz
     *
     * ARR:
     *
     * 10000 - 1
     *
     * Overflow:
     *
     * 1 second
     *
     **************************************************************/


    TIM timer(
        TIM_Instance::TIM2
    );


    timer.init(
        TIM_CounterMode::UP
    );


    timer.setPrescaler(
        8400 - 1
    );


    timer.setAutoReload(
        10000 - 1
    );


    timer.start();




    /**************************************************************
     * ADC Test
     *
     * ADC1 Channel 0
     **************************************************************/


    ADC adc(
        ADC_Instance::ADC1
    );


    adc.init(
        ADC_Resolution::BITS_12,
        ADC_Alignment::RIGHT,
        ADC_MODE::SINGLE
    );


    adc.selectChannel(
        ADC_Channel::CH0
    );





    /**************************************************************
     * USART1 Test
     **************************************************************/


    USART usart(
        USART_Instance::USART1
    );


    usart.init(
        115200,
        USART_Mode::TX_RX,
        USART_WordLength::BITS_8,
        USART_StopBits::STOP_1,
        USART_Parity::NONE
    );


    usart.txString(
        "USART Driver Test\r\n"
    );





    /**************************************************************
     * SPI1 Test
     **************************************************************/


    SPI spi(
        SPI_Instance::SPI1
    );


    spi.init(
        SPI_Mode::MASTER,
        SPI_BaudRate::DIV8,
        SPI_ClockPolarity::LOW,
        SPI_ClockPhase::FIRST_EDGE,
        SPI_DataSize::BITS_8,
        SPI_SSM::ENABLE
    );





    /**************************************************************
     * I2C1 Test
     **************************************************************/


    I2C i2c(
        I2C_Instance::I2C1
    );


    i2c.init(
        100000,
        I2C_ACK::ENABLE
    );





    /**************************************************************
     * EXTI Test
     *
     * PA0 External Interrupt
     **************************************************************/


    EXTI exti(
        RCC_GPIO::PORTA,
        0
    );


    exti.setTrigger(
        EXTI_Trigger::RISING
    );


    exti.enableInterrupt();





    /**************************************************************
     * Main Loop
     **************************************************************/


    while(1)
    {


        /******************************************************
         * TIM Update Event
         *
         * Toggle LED every 1 second
         ******************************************************/

        if(timer.isUpdateEvent())
        {

            timer.clearUpdateEvent();


            led.toggle();


            usart.txString(
                "TIM Update\r\n"
            );

        }




        /******************************************************
         * ADC Conversion Test
         ******************************************************/

        adc.startConversion();


        if(adc.conversionComplete())
        {

            uint16_t adcValue;


            adcValue = adc.read();


            /*
             * Add breakpoint here
             *
             * Check ADC value
             */


            (void)adcValue;

        }


    }


}
