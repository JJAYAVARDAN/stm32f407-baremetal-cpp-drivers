#include "GPIO_Driver.h"
#include "TIM_Driver.h"



int main()
{


    /**********************************************************
     * GPIO Configuration
     *
     * STM32F407 Discovery LED
     *
     * PD12 -> Green LED
     *
     **********************************************************/

    GPIO led(
        GPIO_Port::PORTD,
        GPIO_Pin::PIN12
    );


    led.setMode(GPIO_Mode::OUTPUT);



    /**********************************************************
     * TIM2 Configuration
     *
     * Timer clock = 84MHz
     *
     * Prescaler = 8400
     *
     * Timer frequency:
     *
     * 84MHz / 8400 = 10KHz
     *
     * ARR = 10000
     *
     * Overflow time:
     *
     * 10000 / 10000Hz = 1 second
     *
     **********************************************************/

    TIM tim2(
        TIM_Instance::TIM2
    );


    tim2.init(
        TIM_CounterMode::UP
    );


    tim2.setPrescaler(
        8400 - 1
    );


    tim2.setAutoReload(
        10000 - 1
    );


    tim2.start();



    while(1)
    {


        /*
         * Wait for update event
         */

        if(tim2.isUpdateEvent())
        {


            /*
             * Clear update flag
             */

            tim2.clearUpdateEvent();



            /*
             * Toggle LED
             */

            led.toggle();

        }


    }


}
